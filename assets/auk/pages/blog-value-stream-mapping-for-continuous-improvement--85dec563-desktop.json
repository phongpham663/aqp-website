  "headings": [
    {
      "tag": "H1",
      "text": "Value Stream Mapping for Continuous Improvement"
    },
    {
      "tag": "H3",
      "text": "Be the organisation that understands and utilitises value stream mapping"
    },
    {
      "tag": "H3",
      "text": "Start by mapping out the current VSM and future-state VSM"
    },
    {
      "tag": "H3",
      "text": "Do value stream mapping for one product family – one at a time"
    },
    {
      "tag": "H3",
      "text": "Creating a new role: The Value Stream Manager (the personnel who is responsible for managing the value stream)"
    },
    {
      "tag": "H3",
      "text": "Understanding and collecting key information for the value stream team to drive performance"
    },
    {
      "tag": "H3",
      "text": "Ready to get the ball rolling: Scenario-based practice on value stream mapping"
    },
    {
      "tag": "H3",
      "text": "Step 1: Appoint a value stream manager and the members to make up the value stream team"
    },
    {
      "tag": "H3",
      "text": "Step 2: Decide to do value stream mapping on widget A’s process"
    },
    {
      "tag": "H3",
      "text": "Step 3: Collect current-state information and draw current-state map"
    },
    {
      "tag": "H3",
      "text": "Step 4: Analyse the current state"
    },
    {
      "tag": "H3",
      "text": "Step 5: Map out the future-state value stream map"
    },
    {
      "tag": "H3",
      "text": "Step 6: Create an action plan and effect changes"
    },
    {
      "tag": "H3",
      "text": "Step 7: Measure and review the results"
    },
